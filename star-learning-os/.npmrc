# Nota Windows: si pnpm cuelga ejecutando scripts en esta máquina, el ~/.npmrc
# global debe fijar script-shell al bash de Git (NO cmd.exe). No fijarlo aquí:
# una ruta de Windows en el repo rompe los builds en Linux (Vercel/Railway).

# Red flaky: reintentos agresivos y menor concurrencia para no estancar descargas grandes
fetch-retries=5
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
fetch-timeout=120000
network-concurrency=4
