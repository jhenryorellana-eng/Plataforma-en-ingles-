# El ~/.npmrc global de esta máquina fija script-shell=cmd.exe, que pnpm invoca
# con sintaxis POSIX (-c) y cuelga todos los scripts. Override local a bash de Git.
script-shell=C:/Program Files/Git/usr/bin/bash.exe

# Red flaky: reintentos agresivos y menor concurrencia para no estancar descargas grandes
fetch-retries=5
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
fetch-timeout=120000
network-concurrency=4
