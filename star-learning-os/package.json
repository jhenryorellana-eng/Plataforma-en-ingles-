{
  "name": "star-learning-os",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.16.1",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "db:up": "node scripts/devdb.mjs up",
    "db:stop": "node scripts/devdb.mjs stop",
    "db:status": "node scripts/devdb.mjs status",
    "db:migrate": "pnpm --filter @star/api db:migrate",
    "db:seed": "pnpm --filter @star/api db:seed",
    "dev:api": "pnpm --filter @star/api dev",
    "dev:web": "pnpm --filter @star/web dev"
  },
  "devDependencies": {
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^9.39.5",
    "prettier": "^3.4.2",
    "turbo": "^2.10.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.64.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "@tailwindcss/oxide",
      "sharp",
      "unrs-resolver",
      "@embedded-postgres/windows-x64"
    ]
  }
}
