# Copiar a .env y ajustar. NUNCA commitear .env con claves reales.

# Base de datos local (PostgreSQL embebido, `pnpm db:up`)
DATABASE_URL=postgresql://postgres@127.0.0.1:55432/star
# Prisma usa 2*CPU+1 conexiones por defecto. Mantener este límite bajo en el
# pool compartido; para serverless usar Transaction Pooler y normalmente 1.
DATABASE_POOL_SIZE=3

# Base de datos de PRODUCCIÓN (Supabase, proyecto "Academia de ingles").
# Copia el string "Session pooler" desde el dashboard (botón Connect) y pega
# aquí SOLO en tu .env local o en el hosting — jamás en el repo ni en chats.
# Railway/servidor persistente: Session Pooler (5432) + DATABASE_POOL_SIZE=3.
# Serverless: Transaction Pooler (6543) + DATABASE_POOL_SIZE=1.
# DATABASE_URL=postgresql://postgres.addkqfebkufynjovqxsv:[PASSWORD]@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
ENABLE_DEV_LOGIN=true
OUTBOX_DISPATCH_MODE=local-log
# Producción: publicar a un receptor HTTPS autenticado. El secreto debe ser aleatorio (32+ caracteres)
# y vivir solo en el gestor de secretos del hosting; no incluyas un valor real aquí.
# OUTBOX_DISPATCH_MODE=webhook
# OUTBOX_WEBHOOK_URL=https://events.example.com/star/outbox
# OUTBOX_WEBHOOK_SECRET=
# Solo mantenimiento operativo de producción: conserva eventos sin publicarlos y deja readiness en 503.
# OUTBOX_MAINTENANCE_MODE=false
# Producción exige un valor aleatorio de 32+ caracteres.
SESSION_SECRET=dev-only-secret-change-in-production

# Supabase Auth: alumnos con alta inmediata; apoderados con confirmación de correo obligatoria.
# Agregar los redirects /es-PE/login?verified=1 y /es-PE/reset-password bajo WEB_ORIGIN.
# Sin estas 3 variables la API usa un proveedor mock en memoria (solo dev/smoke).
# SECRET key: dashboard → Project Settings → API Keys → "Secret keys" (sb_secret_...).
# Es la llave admin: SOLO servidor, jamás al cliente, al repo ni a un chat.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# OpenAI — la clave vive SOLO en el servidor (Stack §2.6).
# Sin clave, la voz funciona en modo demo (mock) para desarrollo.
OPENAI_API_KEY=
REALTIME_MODEL_TUTOR_PRIMARY=gpt-realtime
REALTIME_VOICE=marin
# Modelo de texto para el autor IA del Estudio de contenido (vacío = plantillas locales)
OPENAI_TEXT_MODEL=

# Gate técnico 12-13: solo true cuando Starbiz tenga ZDR aprobado y verificado (Stack §1.1)
ZDR_VERIFIED=false

# Web
# URL server-side usada por Next para su proxy same-origin /v1.
API_INTERNAL_URL=http://localhost:4000
# Solo para una app móvil nativa que deba llamar la API directamente.
# NEXT_PUBLIC_API_URL=https://api.example.com

# App nativa (Capacitor): URL que carga el shell nativo.
# Emulador Android: http://10.0.2.2:3000 · Dispositivo real: http://<IP-de-tu-PC>:3000
CAP_SERVER_URL=
