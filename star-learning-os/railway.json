{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "pnpm --filter @star/api... build"
  },
  "deploy": {
    "preDeployCommand": ["pnpm --filter @star/api db:migrate"],
    "startCommand": "pnpm --filter @star/api start",
    "healthcheckPath": "/v1/health/ready",
    "healthcheckTimeout": 300,
    "overlapSeconds": 30,
    "drainingSeconds": 15
  }
}
